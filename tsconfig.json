{
    "compilerOptions": {
        "checkJs": true,
        "allowJs": true,
        "noEmit": true,
        "strict": false,
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "ES2023", "DOM", "DOM.Iterable"],
        "skipLibCheck": true
    },
    "include": ["src/**/*.js", "index.js", "types/**/*.d.ts"],
    "exclude": ["node_modules", "lib"]
}
